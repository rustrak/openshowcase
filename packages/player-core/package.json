{
  "name": "@rustrak/openshowcase-player-core",
  "version": "0.1.0",
  "description": "Framework-agnostic player for OpenShowcase interactive demos",
  "keywords": [
    "openshowcase",
    "interactive-demo",
    "product-demo",
    "product-tour",
    "player"
  ],
  "license": "MIT",
  "author": "AbianS",
  "homepage": "https://github.com/rustrak/openshowcase/tree/main/packages/player-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustrak/openshowcase.git",
    "directory": "packages/player-core"
  },
  "bugs": {
    "url": "https://github.com/rustrak/openshowcase/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@rustrak/openshowcase-schema": "workspace:*"
  },
  "devDependencies": {
    "@rslib/core": "catalog:tooling",
    "@size-limit/esbuild": "catalog:tooling",
    "@size-limit/file": "catalog:tooling",
    "@tailwindcss/postcss": "catalog:tailwind",
    "@tailwindcss/vite": "catalog:tailwind",
    "@vitest/browser": "catalog:tooling",
    "@vitest/browser-playwright": "catalog:tooling",
    "@vitest/ui": "catalog:tooling",
    "alien-signals": "3.2.1",
    "playwright": "catalog:tooling",
    "size-limit": "catalog:tooling",
    "tailwindcss": "catalog:tailwind",
    "typescript": "catalog:core",
    "vite": "catalog:tooling",
    "vitest": "catalog:tooling"
  }
}
