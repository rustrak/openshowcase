{
  "name": "openshowcase",
  "private": true,
  "scripts": {
    "prepare": "lefthook install",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "biome check .",
    "test": "turbo run test",
    "size": "turbo run size",
    "format": "biome check --write .",
    "check-types": "turbo run check-types",
    "ci": "biome ci . && turbo run build check-types test size",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "lefthook": "2.1.14",
    "turbo": "2.11.3",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": "^22.19.0 || ^24.5.0 || >=26.0.0"
  }
}
