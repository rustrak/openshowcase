{
  "name": "@rustrak/openshowcase-player-vue",
  "version": "0.3.0",
  "description": "Vue component for playing OpenShowcase interactive demos",
  "keywords": [
    "openshowcase",
    "interactive-demo",
    "product-demo",
    "product-tour",
    "player",
    "vue"
  ],
  "license": "MIT",
  "author": "AbianS",
  "homepage": "https://github.com/rustrak/openshowcase/tree/main/adapters/player-vue#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustrak/openshowcase.git",
    "directory": "adapters/player-vue"
  },
  "bugs": {
    "url": "https://github.com/rustrak/openshowcase/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build && vue-tsc -p tsconfig.build.json --declaration --emitDeclarationOnly --noEmit false --outDir dist",
    "dev": "rslib build --watch",
    "check-types": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "dependencies": {
    "@rustrak/openshowcase-player-core": "workspace:*",
    "@rustrak/openshowcase-schema": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "size-limit": [
    {
      "name": "dist/index.js (brotli)",
      "path": "dist/index.js",
      "limit": "5 KB"
    }
  ],
  "devDependencies": {
    "@rsbuild/plugin-vue": "2.0.1",
    "@rslib/core": "catalog:tooling",
    "@rustrak/openshowcase-exporter": "workspace:*",
    "@size-limit/file": "catalog:tooling",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/browser-playwright": "catalog:tooling",
    "@vue/language-core": "3.3.11",
    "playwright": "catalog:tooling",
    "size-limit": "catalog:tooling",
    "typescript": "catalog:vue-tooling",
    "vitest": "catalog:tooling",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
