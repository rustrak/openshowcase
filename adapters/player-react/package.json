{
  "name": "@rustrak/openshowcase-player-react",
  "version": "0.0.0",
  "description": "React component for playing OpenShowcase interactive demos",
  "keywords": [
    "openshowcase",
    "interactive-demo",
    "product-demo",
    "product-tour",
    "player",
    "react"
  ],
  "license": "MIT",
  "author": "AbianS",
  "homepage": "https://github.com/rustrak/openshowcase/tree/main/adapters/player-react#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rustrak/openshowcase.git",
    "directory": "adapters/player-react"
  },
  "bugs": {
    "url": "https://github.com/rustrak/openshowcase/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rslib build",
    "dev": "rslib build --watch",
    "check-types": "tsc --noEmit",
    "size": "size-limit"
  },
  "dependencies": {
    "@rustrak/openshowcase-player-core": "workspace:*",
    "@rustrak/openshowcase-schema": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "size-limit": [
    {
      "name": "dist/index.js (brotli)",
      "path": "dist/index.js",
      "limit": "5 KB"
    }
  ],
  "devDependencies": {
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "1.0.1",
    "@size-limit/file": "14.0.0",
    "@types/react": "19.3.0",
    "size-limit": "14.0.0",
    "typescript": "6.0.3"
  }
}
